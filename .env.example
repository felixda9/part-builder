# Copy to .env and set one image source. Or set none and use your own pictures.

# Your own GPU with ComfyUI (free). See docs/local-gpu.md.
# COMFYUI_URL=http://127.0.0.1:8188
# ...or start ComfyUI on another PC over SSH when needed (that PC must run Windows + Comfy Desktop):
# COMFYUI_SSH=user@gpu-pc
# COMFYUI_SSH_KEY=~/.ssh/id_ed25519

# Or an API key (paid, a few cents per image). Set the one you have.
# Gemini: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys (OPENAI_BASE_URL: a service with the same API)
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_BASE_URL=
# fal.ai: https://fal.ai/dashboard/keys (any model: one for text, one that takes images)
# FAL_KEY=
# FAL_MODEL=fal-ai/nano-banana
# FAL_EDIT_MODEL=fal-ai/nano-banana/edit
# Replicate: https://replicate.com/account/api-tokens (any model that takes images)
# REPLICATE_API_TOKEN=
# REPLICATE_MODEL=google/nano-banana

# Which one to use when several are set: comfyui, gemini, openai, fal or replicate
# IMAGE_PROVIDER=comfyui

# Editor port (default 5178)
# PART_BUILDER_PORT=5178

# 1 = offline test mode: no image source needed, every "generated" image is a demo model
# PART_BUILDER_FAKE_IMAGES=1
